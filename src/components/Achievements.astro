---
import SectionHeader from './SectionHeader.astro';
import { achievements } from '../data/site';
---

<section class="section" id="achievements" aria-labelledby="achievements-title">
  <div class="container">
    <SectionHeader
      id="achievements"
      title="Results, with the fine print."
      intro="Measured project results. Each figure comes with its context, so you can judge it for yourself."
    />

    <ul class="ach" role="list">
      {
        achievements.map((a, i) => (
          <li class="ach__item" data-spotlight data-reveal style={`--d:${i % 2}`}>
            <p class="ach__figure" aria-hidden="true">{a.figure}</p>
            <h3 class="ach__title">
              <span class="sr-only">{a.figure}: </span>
              {a.title}
            </h3>
            <p class="ach__context">{a.context}</p>
            <p class="ach__source mono">
              {a.href ? (
                <a href={a.href}>
                  {a.source}
                  <span class="sr-only"> (see Projects)</span>
                </a>
              ) : (
                a.source
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ach {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  .ach__item {
    display: flex;
    flex-direction: column;
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    overflow: hidden;
    transition: border-color 0.3s var(--ease-out);
  }
  .ach__item:hover {
    border-color: var(--line-strong);
  }
  .ach__figure {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.5vw, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--lime);
  }
  .ach__title {
    margin-top: 14px;
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .ach__context {
    margin-top: 10px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .ach__source {
    margin-top: auto;
    padding-top: 20px;
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  .ach__source a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    border-bottom: 1px solid var(--line-strong);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .ach__source a::before {
    content: '↳ ';
    white-space: pre;
  }
  .ach__source a:hover {
    color: var(--lime);
    border-color: var(--lime);
  }

  @media (max-width: 760px) {
    .ach {
      grid-template-columns: 1fr;
    }
    .ach__item {
      padding: 24px;
    }
  }
</style>
