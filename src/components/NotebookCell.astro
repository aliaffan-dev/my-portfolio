---
/**
 * A Jupyter-style cell that "runs" and prints a profile dict.
 * Pure markup + CSS; output lines fade in one after another.
 */
interface Props {
  call: string;
  data: Record<string, string | string[]>;
}

const { call, data } = Astro.props;
const entries = Object.entries(data);
---

<figure class="cell" aria-label="Profile summary">
  <div class="cell__bar">
    <span class="cell__file">profile.ipynb</span>
    <span class="cell__kernel"><span class="cell__dot" aria-hidden="true"></span>Python 3</span>
  </div>

  <div class="cell__body mono">
    <div class="cell__row">
      <span class="cell__prompt">In&nbsp;[1]:</span>
      <code class="cell__code">
        <span class="t-fn">{call}</span><span class="cell__caret" aria-hidden="true"></span>
      </code>
    </div>

    <div class="cell__row cell__row--out">
      <span class="cell__prompt cell__prompt--out">Out[1]:</span>
      <div class="cell__out"><span class="line" style="--i:0"><span class="t-p">{'{'}</span></span>{
  entries.map(([key, value], i) => (
    <span class="line line--entry" style={`--i:${i + 1}`}>
      <span class="t-k">'{key}'</span><span class="t-p">: </span>{
        Array.isArray(value) ? (
          <>
            <span class="t-p">[</span>
            {value.map((v, j) => (
              <>
                <span class="t-s">'{v}'</span>
                {j < value.length - 1 && <span class="t-p">, </span>}
              </>
            ))}
            <span class="t-p">]</span>
          </>
        ) : (
          <span class="t-s">'{value}'</span>
        )
      }{i < entries.length - 1 && <span class="t-p">,</span>}
    </span>
  ))
}<span class="line" style={`--i:${entries.length + 1}`}><span class="t-p">{'}'}</span></span></div>
    </div>
  </div>
</figure>

<style>
  .cell {
    position: relative;
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.025), transparent 40%),
      var(--bg-raised);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 30px 80px -30px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }

  .cell__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    font: 500 0.75rem/1 var(--font-mono);
    color: var(--text-faint);
  }
  .cell__kernel {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cell__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 10px var(--lime);
  }

  .cell__body {
    padding: 20px 18px 24px;
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .cell__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 8px;
    min-width: 0;
  }
  .cell__row--out {
    margin-top: 14px;
  }

  .cell__prompt {
    color: var(--text-faint);
    user-select: none;
  }
  .cell__prompt--out {
    color: var(--lime);
    opacity: 0.75;
  }

  .cell__code {
    display: flex;
    align-items: center;
    padding: 6px 12px;
    margin: -6px 0;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.035);
    border: 1px solid var(--line);
    font: inherit;
    min-width: 0;
  }
  .cell__caret {
    display: inline-block;
    width: 7px;
    height: 1.1em;
    margin-left: 3px;
    background: var(--lime);
    animation: blink 1.1s steps(1) infinite;
  }

  .cell__out {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* Hanging indent: wrapped continuation lines sit deeper than the key */
  .line--entry {
    padding-left: 4ch;
    text-indent: -2ch;
  }
  .line {
    display: block;
    opacity: 0;
    animation: line-in 0.5s var(--ease-out) forwards;
    animation-delay: calc(900ms + var(--i) * 110ms);
  }

  .t-k { color: var(--syn-key); }
  .t-s { color: var(--syn-str); }
  .t-p { color: var(--syn-punc); }
  .t-fn { color: var(--syn-fn); }

  @keyframes blink {
    50% { opacity: 0; }
  }
  @keyframes line-in {
    from { opacity: 0; transform: translateX(-6px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 480px) {
    .cell__body { font-size: 0.74rem; padding-inline: 14px; }
    .cell__row { grid-template-columns: 3.6rem 1fr; }
  }
</style>
